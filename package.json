{
  "name": "mapmarkerplus",
  "version": "1.0.0",
  "description": "Map scripts of the MapMarkerPlus ProcessWire module (MapLibre via map-engine, Google Maps, Yandex Maps)",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/check-dist-fresh.mjs --write",
    "watch": "vite build --watch",
    "check:dist": "node scripts/check-dist-fresh.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@sla/map-engine": "file:../../../map-engine",
    "maplibre-gl": "^5.23.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@yandex/ymaps3-types": "^1.0.21108841",
    "terser": "^5.46.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  }
}
